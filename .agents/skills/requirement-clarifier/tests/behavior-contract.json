      "test_case": "TC-36",
      "tags": ["post-delivery-choice"],
      "prompt": "客户列表批量分配页面的完整需求方案已经输出，没有 P0；我之前没有说明要不要 Codex 交互页面提示词或产品经理能力复盘。请按默认工作流完成这次正式需求方案交付。",
      "expected_behaviors": ["offer_post_delivery_output_choice", "wait_for_user_optional_output_choice"],
      "forbidden_behaviors": ["auto_generate_prompt_before_choice", "append_pm_retro"],
