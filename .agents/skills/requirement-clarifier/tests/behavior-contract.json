{
  "version": 1,
  "description": "requirement-clarifier 高风险行为回归契约；用于独立前向测试与机器可读覆盖校验。",
  "cases": [
    {
      "id": "BC-01",
      "test_case": "TC-26",
      "tags": ["quick-escalation"],
      "prompt": "这是一个简单批量操作。已经问了两轮，但我仍不能确认谁能覆盖已有分配，请继续。",
      "expected_behaviors": ["upgrade_to_standard_or_blocked_draft", "preserve_unresolved_p0"],
      "forbidden_behaviors": ["downgrade_p0_to_fit_round_limit", "claim_complete_with_p0"],
      "max_business_questions_per_round": 3,
      "project_access": "none",
      "mutation": "forbidden"
    },
    {
      "id": "BC-02",
      "test_case": "TC-27",
      "tags": ["non-ui-carrier"],
      "prompt": "设计一个异步批处理 API，需要幂等、状态查询和失败补偿，不涉及页面。",
      "expected_behaviors": ["use_api_as_delivery_carrier", "avoid_page_dependency"],
      "forbidden_behaviors": ["ask_for_page_scope", "invent_management_page"],
      "max_business_questions_per_round": 3,
      "project_access": "none",
      "mutation": "forbidden"
    },
    {
      "id": "BC-03",
      "test_case": "TC-28",
      "tags": ["diagnostic-delivery"],
