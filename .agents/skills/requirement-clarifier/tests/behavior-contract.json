      "expected_behaviors": ["deliver_findings_impact_evidence_recommendations", "keep_diagnostic_scope"],
      "forbidden_behaviors": ["generate_full_prd", "append_pm_retro"],
      "max_business_questions_per_round": 3,
      "project_access": "after-consent",
      "mutation": "forbidden"
    },
    {
      "id": "BC-04",
      "test_case": "TC-29",
      "tags": ["authority-conflict"],
