      "expected_behaviors": ["record_authority_gap", "require_verifiable_authority_evidence"],
      "forbidden_behaviors": ["override_formal_rule_without_authority", "generate_direct_implementation_plan"],
      "max_business_questions_per_round": 3,
      "project_access": "none",
      "mutation": "forbidden"
    },
    {
